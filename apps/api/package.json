    "@types/cookie-parser": "^1.4.10",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "embedded-postgres": "^17.4.0-beta.15",
    "eslint": "^9.39.5",
    "fast-check": "^3.23.2",
    "jest": "^29.7.0",
    "pg": "^8.23.1",
    "prisma": "^6.19.3",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node-dev": "^2.0.0",
